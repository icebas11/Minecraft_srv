# Copie ce fichier en .env (ou colle son contenu dans l'éditeur .env de Dockhand)
# puis adapte les valeurs. Ne versionne jamais le .env.

# Dossier persistant sur TrueNAS (dataset ZFS), monté sur /data
MC_DATA_DIR=/mnt/tank/apps/minecraft/data

# URL brute du pack.toml sur GitHub
# Format : https://raw.githubusercontent.com/<utilisateur>/<repo>/main/pack/pack.toml
PACKWIZ_URL=https://raw.githubusercontent.com/CHANGE-MOI/CHANGE-MOI/main/pack/pack.toml

# Utilisateur propriétaire du dataset (568 = utilisateur "apps" de TrueNAS)
PUID=568
PGID=568

# Mémoire Java (heap) et plafond du conteneur (garder ~1,5-2 Go de marge)
MEMORY=6G
MEM_LIMIT=8g

TZ=Europe/Paris

# Ports exposés sur l'hôte
MC_PORT=25565
BLUEMAP_PORT=8100
# Adresse d'écoute de BlueMap sur l'hôte :
#  0.0.0.0   = accessible sur le LAN (NPMplus en réseau bridge le joint via l'IP du TrueNAS)
#  127.0.0.1 = accessible uniquement via NPMplus, si NPMplus est en network_mode: host
BLUEMAP_BIND=0.0.0.0

# Adresses publiques (pour mémoire, utilisées dans la doc)
# MC_PUBLIC_HOST=monserveur.duckdns.org
# BLUEMAP_PUBLIC_HOST=carte.monserveur.duckdns.org

# Réglages du serveur
MOTD=Serveur entre amis
DIFFICULTY=normal
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
MAX_PLAYERS=10

# Pseudos Minecraft séparés par des virgules
WHITELIST=pseudo1,pseudo2
OPS=pseudo1
